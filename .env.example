# Copier ce fichier en .env puis adapter.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-insecure-key-a-changer-en-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://gestion.mon-hotel.cm
ETABLISSEMENT_NOM=Complexe St Élie Palace
# En ligne : DJANGO_DEBUG=false, une vraie clé, l'adresse du site (README, « Mise en ligne sur PythonAnywhere »).
# SECURE_SSL_REDIRECT=false   # quand l'hébergeur force déjà le HTTPS (PythonAnywhere : « Force HTTPS »)
# Écran verrouillé après N minutes sans activité (0 = jamais) ; on reprend avec son code PIN.
# VERROUILLAGE_MINUTES=10
# Au-delà de ce montant (FCFA), l'application demande « C'est bien ça ? » avant d'enregistrer de l'argent reçu.
# MONTANT_A_CONFIRMER=100000
# Base de données : sqlite3 (défaut), postgresql ou mysql
DB_ENGINE=sqlite3
# DB_NAME=gestion_st_elie
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=
# ENTETE_IP_CLIENT=HTTP_X_REAL_IP   # derrière PythonAnywhere : la vraie adresse du visiteur (limites anti-abus)
